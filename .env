# Deploy config read by docker-compose.yml.
# Committed on purpose — nothing secret here. Lets the NAS run
# `docker compose pull && up -d` straight from a clone, no manual .env step.

# Public image built + pushed by GitHub Actions (.github/workflows/dockerhub.yml).
# To pin a version instead of latest: leafvmaple/map-viewer:v<run>.
MAP_IMAGE=leafvmaple/map-viewer:latest

# NAS directory holding the game data, laid out as:
#   <MAP_DATA_ROOT>/res/{game}/game.json + images
#   <MAP_DATA_ROOT>/public/games/registry.json
MAP_DATA_ROOT=/volume1/docker/map-viewer/data
