{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leafvmaple/map_viewer/schema/items.schema.json",
  "title": "Game Map Viewer - item catalog",
  "type": "object",
  "required": ["items"],
  "additionalProperties": true,
  "properties": {
    "items": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/item" }
    },
    "summary": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "localizedString": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" },
        "ja": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "item": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedString" },
        "price": { "type": "number" },
        "currency": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/localizedString" },
        "itemIcon": { "type": "string", "minLength": 1 }
      }
    }
  }
}
