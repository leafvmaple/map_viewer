# Copy to .env on the NAS. Used by docker-compose.yml.

# Image built + pushed by CI to the Gitea registry (same host as vn-resource-vault).
MAP_IMAGE=10.0.0.20:42197/leafvmaple/map_viewer:latest

# NAS directory that holds the game data, laid out as:
#   <MAP_DATA_ROOT>/res/{game}/game.json + images
#   <MAP_DATA_ROOT>/games/registry.json
MAP_DATA_ROOT=/volume1/docker/map-viewer/data
